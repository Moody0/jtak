# dotnet publish output. Regenerated by `dotnet publish` on any machine, and
# ~66MB per copy, so it is rebuilt rather than carried in the repository.
publish_backend/
publish_output/
publish_*_20260915/
jtak-backend-main/publish_backend/
jtak-backend-main/publish_output/
jtak-backend-main/publish_*_20260915/

# Compiled deploy snapshots. Same reason as publish output: rebuilt by
# `dotnet publish`, ~66MB per copy, and never edited by hand. The SQL sync
# folders and product backups alongside them are data and stay in the repo.
artifacts/backend_deploy_*/
artifacts/backend_package_*/

# Kotlin incremental build cache.
**/android/.kotlin/
