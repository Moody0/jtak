@using App.Resources
@model App.Areas.Admin.Models.ForceResetPasswordVm

<div class="content-heading">
    <div>
        @_Account.ResetPassword
        <small>@ViewBag.UserDisplayName (@ViewBag.UserEmail)</small>
    </div>
</div>
<div class="container-fluid">
    <form asp-action="ResetPassword">
        <div class="card card-default">
            <div class="card-body">
                <input asp-for="Email" type="hidden" />
                @Html.EditorFor(x => x.NewPassword)
                @Html.EditorFor(x => x.ConfirmPassword)
            </div>
            <div class="card-footer text-right">
                <div class="btn-group">
                    <a asp-action="Index" class="btn btn-secondary">@_Common.BackToList</a>
                    <input type="submit" value="@_Common.Save" class="btn btn-success" />
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}