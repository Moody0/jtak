@using App.Shared.Entities.Resources
@using App.Resources
@using Solf.Extensions
@model App.Shared.Entities.UserDto

<div class="container-fluid">
    <div class="card card-default">
        <div class="card-header">
            <em class="fa fa-users p-2"></em> @_Common.Manage @_Nav.Users.
            <div class="dt-buttons btn-group d-none">
                <a asp-action="CreateAdmin" class="btn btn-success float-right" data-toggle="tooltip" title="@_Common.Create @App.Shared.Entities.Enums.AppRoleName.Admin.ToLocalizedName()"><i class="fa fa-plus"></i></a>
            </div>
        </div>
        <div class="card-body">
            <div class="row d-none">
                <div class="col-lg-4">
                    @Html.EditorFor(x => x.Role, new { placeholder = _Common.All })
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12">
                    <table id="datatable" class="table table-striped w-100">
                        <thead>
                            <tr>
                                <th>@Html.DisplayNameFor(x => x.FullName)</th>
                                <th>@Html.DisplayNameFor(x => x.Email)</th>
                                <th>@Html.DisplayNameFor(x => x.CreatedDate)</th>
                                <th class="no"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="5">@_Common.LoadingData </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/vendor/datatables.net-bs4/css/dataTables.bootstrap4.css">
    <link rel="stylesheet" href="~/vendor/datatables.net-keytable-bs/css/keyTable.bootstrap.css">
    <link rel="stylesheet" href="~/vendor/datatables.net-responsive-bs/css/responsive.bootstrap.css">
}

@section Scripts {
    <script src="~/js/sol.datatables.min.js"></script>
    <script>
        $(function() {
            if (!$.fn.dataTable) return;

            var dtInstance = $('#datatable').dataTable({
                lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]],
                processing: true,
                serverSide: true,
                ajax: { url: "@Url.Action("Index")", data: function (d) { d.Id = $("#Role").val(); }, type: "POST" },
                paging: true,
                ordering: true,
                info: true,
                responsive: true,
                columns: [
                    { name: 'FullName', data: 'fullName', title: '@_AppUser.FullName', sortable: true, searchable: false },
                    { name: 'Email', data: 'email', title: '@_Account.Email', sortable: true, searchable: false },
                    { name: 'CreatedDate', data: 'createdDate', title: '@_Entities.CreatedDate', sortable: true, searchable: false, render: $.fn.dataTable.render.date() },
                    {
                        name: 'actions',
                        className: 'actionbuttons',
                        data: null,
                        title: '',
                        width: '150px', sortable: false, searchable: false,
                        render: function(data, type, row) {
                            var enableBtn = row.isActive === false ?`<a href="@Url.Action("Enable")/${row["id"]}" class="btn btn-outline-success" data-toggle="tooltip" title="@_Common.Enable"><i class="fa fa-check"></i></a>`:`<a href="@Url.Action("Disable")/${row["id"]}" class="btn btn-outline-danger" data-toggle="tooltip" title="@_Common.Disable"><i class="fa fa-times"></i></a>`;
                            return `<div class="dt-buttons btn-group">
                                        <a href="@Url.Action("Details")/${row["id"]}" class="btn btn-outline-success" data-toggle="tooltip" title="@_Common.Details"><i class="fa fa-search"></i></a>
                                        <a href="@Url.Action("ResetPassword")/${row["id"]}" class="btn btn-outline-warning" data-toggle="tooltip" title="@_Account.ResetPassword"><i class="fa fa-key"></i></a>
                                        ${enableBtn}
                                    </div>`;
                        }
                    }
                ],
                oLanguage: @Html.Raw(_Common.DataTablesLang),
                //dom: '<"html5buttons"B>lTfgtip',
                buttons: [
                    {
                        extend: 'excel',
                        className: 'btn-sm',
                        title: $('title').text(),
                        exportOptions: { columns: ':not(.actionbuttons)' }
                    },
                    { extend: 'copy', className: 'btn-sm', exportOptions: { columns: ':not(.actionbuttons)' } },
                    { extend: 'csv', className: 'btn-sm', exportOptions: { columns: ':not(.actionbuttons)' } },
                    {
                        extend: 'pdf',
                        className: 'btn-sm',
                        title: $('title').text(),
                        exportOptions: { columns: ':not(.actionbuttons)' }
                    },
                    { extend: 'print', className: 'btn-sm', exportOptions: { columns: ':not(.actionbuttons)' } }
                ],
                initComplete: function (settings, json) {
                    $('#datatable [data-toggle="tooltip"]').tooltip({ container: 'body'});
                },
                stateSave: true
            });

            var inputSearchClass = 'datatable_input_col_search';
            var columnInputs = $('tfoot .' + inputSearchClass);

            // On input keyup trigger filtering
            columnInputs.keyup(function() {
                dtInstance.fnFilter(this.value, columnInputs.index(this));
            });

            $("#Role").change(function () {
                $('#datatable').DataTable().ajax.reload();
            });
        });
    </script>
}
