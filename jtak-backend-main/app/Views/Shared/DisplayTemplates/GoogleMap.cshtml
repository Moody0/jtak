@using App.Extensions
@model string
@{
    var defaultHtmlAttributesObject = new { style = "border-radius:0px;border-bottom-width:0px" };

    var latitudeVal = "40.986189";
    var longitudeVal = "28.9898774";

    if (Model != null && Model.IndexOf(',') > 0)
    {
        latitudeVal = Model.Split(',')[0];
        longitudeVal = Model.Split(',')[1];
    }

    var fieldName = ViewData.TemplateInfo.HtmlFieldPrefix;
}

@Html.Hidden("Latitude")
@Html.Hidden("Longitude")

<div>
    <div class="form-group">
        <div class="">
            <div id="@fieldName" style="width: 100%; height: 400px; border: 1px solid #ccc;"></div>
        </div>
    </div>
</div>


@Html.Script(
    @<script defer src="https://maps.google.com/maps/api/js?key=AIzaSyBk2cKUejJ6r1R4juhCF4DKpelMc-twebU&callback=initMap&sensor=false"></script>
)

@Html.Script(@<script type="text/javascript">
        function initMap() {
            const uluru = { lat: @latitudeVal, lng: @longitudeVal };
            // The map, centered at Uluru
            const map = new google.maps.Map(document.getElementById("@fieldName"),
                {
                    zoom: 12,
                    center: uluru,
                });

            // The marker, positioned at Uluru
            const marker = new google.maps.Marker({position: uluru,map: map});
        }
</script>)