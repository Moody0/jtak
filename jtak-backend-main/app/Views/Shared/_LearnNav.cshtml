@using App.Extensions
@using Solf.Extensions
@using System.Globalization


<header class="header-appear">
    <nav class="navbar navbar-top-default navbar-expand-lg static-nav transparent-bg nav-bottom-line">
        <div class="container">
            <a class="logo" href="javascript:void(0)">
                <img src="/images/logo-white.svg" style="height:50px;" alt="logo" title="@_Common.SiteName" class="logo-default">
                <img src="/images/logo.svg" style="height:50px;" alt="logo" title="@_Common.SiteName" class="logo-scrolled">
            </a>
            <div class="collapse navbar-collapse d-none d-lg-block">
                <ul class="nav navbar-nav ml-auto mr-4">
                    <li class="nav-item"> <a href="#home" class="scroll nav-link">@_Nav.Home</a></li>
                    @{
                        var otherCulture = new CultureInfo[] { new CultureInfo("ar"), new CultureInfo("en") }.FirstOrDefault(x => x.TwoLetterISOLanguageName != System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName);

                    }
                    <li class="nav-item"> <a href="@Url.Action("ChangeLanguage","Dashboard", new{area="",id = otherCulture.Name, returnurl = $"{Context.Request.Path}{Context.Request.QueryString}" })" class="nav-link"> @otherCulture.NativeName </a></li>

                </ul>
            </div>
            <a href="#request" class="scroll btn-setting btn-scale btn-red text-white d-none d-lg-block">@_Account.SignIn</a>

            <!-- side menu open button -->
            <a class="menu_bars d-inline-block d-lg-none menu-bars-setting" id="sidemenu_toggle">
                <div class="menu-lines">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </a>
        </div>
    </nav>
    <div class="side-menu">
        <div class="inner-wrapper nav-icon">
            <span class="btn-close" id="btn_sideNavClose"></span>
            <nav class="side-nav w-100">
                <div class="navbar-nav">
                    <a href="#home" class="scroll nav-link">@_Nav.Home</a>
                    <a class="menu-line"><i class="fa fa-angle-right font-14" aria-hidden="true"></i></a>
                </div>
            </nav>
            <div class="side-footer text-white w-100">
                <ul class="social-icons-simple">
                    <li class="side-menu-icons"><a href="javascript:void(0)"><i class="fab fa-facebook-f color-white"></i></a></li>
                    <li class="side-menu-icons"><a href="javascript:void(0)"><i class="fab fa-instagram color-white"></i></a></li>
                    <li class="side-menu-icons"><a href="javascript:void(0)"><i class="fab fa-twitter color-white"></i></a></li>
                </ul>
                <p class="text-white">&copy; @DateTime.Now.Year @_Common.SiteName</p>
            </div>
        </div>
    </div>
    <a id="close_side_menu" href="javascript:void(0);"></a>
    <!--Side Menu-->
</header>

