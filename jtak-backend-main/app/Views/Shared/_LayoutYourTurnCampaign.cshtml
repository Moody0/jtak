@using App.Extensions
@using App.Resources
@using Solf.Extensions
@using App.Shared.Services.Helpers
@model dynamic
@{
    var lang = System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName;
    var RTLext = lang == "ar" ? "-rtl" : "";
    var isRtl = System.Threading.Thread.CurrentThread.CurrentCulture.TextInfo.IsRightToLeft;

    var m = Model is App.Shared.Entities.ISeoPage ? Model as App.Shared.Entities.ISeoPage : null;
    var seoTitle = m?.SeoTitle != null ? m?.SeoTitle + " - " + _Common.SiteName : @_Common.SiteName;
    var seoDescription = m?.SeoDescription;
    var seoImage = m?.SeoFeaturedImage;
}
<!DOCTYPE html>
<html lang="@lang" dir="@(isRtl?"rtl":"ltr")">
<head>
    <meta charset="UTF-8">
    <title>@seoTitle</title>
    <meta name="description" content="@seoDescription">
    <meta name="author" content="SOL Integrated Solutions">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    @if (seoImage != null)
    {
        <meta property="og:image" content="@AppDomainHelper.BaseUrl/ar/PreviewImage/@seoImage?w=1200&h=627">
        <meta property="og:image:type" content="image/jpeg">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="627">
    }

    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="apple-touch-icon" sizes="57x57" href="/fav/apple-icon-57x57.png">
    <link rel="apple-touch-icon" sizes="60x60" href="/fav/apple-icon-60x60.png">
    <link rel="apple-touch-icon" sizes="72x72" href="/fav/apple-icon-72x72.png">
    <link rel="apple-touch-icon" sizes="76x76" href="/fav/apple-icon-76x76.png">
    <link rel="apple-touch-icon" sizes="114x114" href="/fav/apple-icon-114x114.png">
    <link rel="apple-touch-icon" sizes="120x120" href="/fav/apple-icon-120x120.png">
    <link rel="apple-touch-icon" sizes="144x144" href="/fav/apple-icon-144x144.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/fav/apple-icon-152x152.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/fav/apple-icon-180x180.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/fav/android-icon-192x192.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/fav/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/fav/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/fav/favicon-16x16.png">
    <link rel="manifest" href="/fav/manifest.json">
    <meta name="msapplication-TileColor" content="#ffffff">
    <meta name="msapplication-TileImage" content="/fav/ms-icon-144x144.png">
    <meta name="theme-color" content="#ffffff">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <link rel="stylesheet" href="/theme/vendor/css/bundle@(RTLext).min.css">
    <link rel="stylesheet" href="/theme/vendor/css/select2.min.css">
    <link rel="stylesheet" href="/theme/css/style@(RTLext).css">
    <link rel="stylesheet" href="/theme/css/custom.css">


    @if (IsSectionDefined("Styles"))
    {@RenderSection("Styles", required: false)}
    <link href="~/vendor/tempusdominus-bootstrap-4/build/css/tempusdominus-bootstrap-4.min.css" rel="stylesheet" />
    <link href="~/vendor/filepond/dist/filepond.min.css" rel="stylesheet" />
    <link href="~/vendor/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.min.css" rel="stylesheet" />
</head>
<body data-spy="scroll" data-target=".navbar-nav" data-offset="90">
    <header class="d-flex align-items-stretch bg-light-gray">
        <div class="container d-flex justify-content-center">
            <a class="p-4" href="/">
                <img src="/images/logo.svg" style="width:200px;" alt="logo" title="@_Common.SiteName" class="logo-scrolled">
            </a>
        </div>
    </header>

    <div style="min-height: calc(100vh - 78px);">
        @RenderBody()
    </div>


    <footer class="bg-dark pt-1 text-light">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="copyright-area d-flex flex-wrap justify-content-center justify-content-sm-between text-center py-4">
                        <div class="copyright-left">@Html.Raw(string.Format(_Common.AllRightsResirved, DateTime.UtcNow.Year)) - @_Common.SiteName</div>
                        <div class="copyright-right d-none">@Html.Raw(_Common.BroughtToYouBy)</div>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="/theme/vendor/js/bundle.min.js"></script>
    <script src="/theme/vendor/js/jquery.fancybox.min.js"></script>
    <script src="/theme/vendor/js/owl.carousel.min.js"></script>
    <script src="/theme/vendor/js/swiper.min.js"></script>
    <script src="/theme/vendor/js/jquery.cubeportfolio.min.js"></script>
    <script src="/theme/vendor/js/jquery.appear.js"></script>
    <script src="/theme/vendor/js/parallaxie.min.js"></script>
    <script src="/theme/vendor/js/wow.min.js"></script>
    <script src="/theme/vendor/js/select2.min.js"></script>
    <script src="/theme/vendor/js/slick.min.js"></script>

    <!-- REVOLUTION JS FILES -->
    <script src="/theme/vendor/js/jquery.themepunch.tools.min.js"></script>
    <script src="/theme/vendor/js/jquery.themepunch.revolution.min.js"></script>
    <!-- SLIDER REVOLUTION EXTENSIONS -->
    <script src="/theme/vendor/js/extensions/revolution.extension.actions.min.js"></script>
    <script src="/theme/vendor/js/extensions/revolution.extension.carousel.min.js"></script>
    <script src="/theme/vendor/js/extensions/revolution.extension.kenburn.min.js"></script>
    <script src="/theme/vendor/js/extensions/revolution.extension.layeranimation.min.js"></script>
    <script src="/theme/vendor/js/extensions/revolution.extension.migration.min.js"></script>
    <script src="/theme/vendor/js/extensions/revolution.extension.navigation.min.js"></script>
    <script src="/theme/vendor/js/extensions/revolution.extension.parallax.min.js"></script>
    <script src="/theme/vendor/js/extensions/revolution.extension.slideanims.min.js"></script>
    <script src="/theme/vendor/js/extensions/revolution.extension.video.min.js"></script>


    <script src="/theme/js/script.js"></script>
    <script src="~/vendor/moment/min/moment-with-locales.min.js"></script>
    <script src="~/vendor/tempusdominus-bootstrap-4/build/js/tempusdominus-bootstrap-4.min.js"></script>

    <style>
        @@font-face {
            font-family: 'Bahij_TheSansArabic';
            font-weight: 700;
            src: url('/fonts/bahij/Bahij_TheSansArabic-Bold.woff2') format('woff2');
            unicode-range: U+0600-06FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE80-FEFC;
        }

        @@font-face {
            font-family: 'Bahij_TheSansArabic';
            font-weight: 300;
            src: url('/fonts/bahij/Bahij_TheSansArabic-ExtraLight.woff2') format('woff2');
            unicode-range: U+0600-06FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE80-FEFC;
        }

        @@font-face {
            font-family: 'Bahij_TheSansArabic';
            font-weight: 400;
            src: url('/fonts/bahij/Bahij_TheSansArabic-Plain.woff2') format('woff2');
            unicode-range: U+0600-06FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE80-FEFC;
        }

        .bootstrap-datetimepicker-widget.dropdown-menu {
            width: 16rem !important;
        }
    </style>
    <link href="//fonts.googleapis.com/css2?family=Raleway:wght@300;400;700&display=swap" rel="stylesheet">
    <link href="//fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;700&display=swap" rel="stylesheet">
    @RenderSection("scripts", required: false)
    @Html.RenderScripts()
</body>
</html>