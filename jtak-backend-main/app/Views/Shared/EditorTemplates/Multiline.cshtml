@model String
@{
    var rows = ViewData["rows"] ?? "3";
}
<div class="form-group">
    <label asp-for="@Model" class="control-label"></label>
    <textarea asp-for="@Model" rows="@rows" class="form-control" placeholder="@ViewData["placeholder"]"></textarea>
    <span asp-validation-for="@Model" class="text-danger"></span>
</div>

