@using App.Resources
@using App.Views.Manage
@model App.Models.ManageViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
    ViewData.AddActivePage(ManageNavPages.ChangePassword);
}

@await Html.PartialAsync("_StatusMessage", Model.StatusMessage)
<div class="container-fluid">
    <form asp-action="ChangePassword">
        <div class="card card-default">
            <div class="card-header"><em class="fa fa-lock p-2"></em> @_Account.Change_My_Password</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        @Html.EditorFor(x => x.OldPassword)
                        @Html.EditorFor(x => x.NewPassword)
                        @Html.EditorFor(x => x.ConfirmPassword)
                    </div>
                </div>
            </div>
            <div class="card-footer text-right">
                <div class="btn-group">
                    <button type="button" onclick="window.history.back()" class="btn btn-secondary">@_Common.BackToList</button>
                    <input type="submit" value="@_Common.Save" class="btn btn-success" />
                </div>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
