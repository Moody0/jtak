@using App.Resources
@{
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
    ViewData["Title"] = _Account.YourPasswordHasBeenChanged;
}

<div class="block-center mt-4 wd-xxl">
    <!-- START card-->
    <div class="card card-flat p-3">
        <div class="card-body">
            <a style="width: 100%; text-align: center; display: inline-block;" href="@Url.Action("Index", "Dashboard")">
                <img style="max-height: 150px;" src="~/images/logo.svg" alt="@_Common.SiteName" title="@_Common.SiteName">
            </a>
        </div>
        <div class="panel-body">
            <h4 class="text-center pv">@_Account.YourPasswordHasBeenChanged</h4>
            <p>
                @_Account.YourPasswordHasBeenChanged <a asp-action="Login">@_Account.ClickHereToLogin</a>.
            </p>
        </div>
    </div>
</div>