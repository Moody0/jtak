@using App.Resources
@using App.Views.Manage
@model App.Models.ManageViewModels.ChangePasswordViewModel
@{
    Layout = null;
}

<section class="col-lg-9">
    <form asp-action="ChangePassword" asp-controller="User" asp-route-id="">
        <div class="m-4">
            @Html.EditorFor(x => x.OldPassword)
            @Html.EditorFor(x => x.NewPassword)
            @Html.EditorFor(x => x.ConfirmPassword)

            <div class="btn-group float-right">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">@_Common.BackToList</a>
                <input type="submit" value="@_Common.Save" class="btn btn-sm btn-outline-success mb-0" />
            </div>
            <br />
            <br />
        </div>
    </form>
</section>