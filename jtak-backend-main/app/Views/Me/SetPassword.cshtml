@using App.Views.Manage
@using App.Shared.Entities
@using App.Shared.Services
@using App.Resources
@model UserDto
@{
    ViewBag.Title = _Account.Profile + " - " + _Account.SetPassword;
}

@await Html.PartialAsync("_Header")
<div class="container clearfix h-100">
    <div class="row mb-4" style="min-height:50vh">
        @await Html.PartialAsync("_UserNav")
        @await Html.PartialAsync("_SetPassword", new App.Models.ManageViewModels.SetPasswordVm())
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    @{await Html.RenderPartialAsync("_ToastrMsg");}
}
