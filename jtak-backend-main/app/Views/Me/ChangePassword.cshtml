@using App.Resources
@using App.Views.Manage
@using App.Shared.Entities
@model UserDto
@{
    ViewBag.Title = _Account.Profile + " - " + _Account.Change_My_Password;
}

@await Html.PartialAsync("_Header")

<div class="container clearfix h-100">
    <div class="row mb-4" style="min-height:50vh">
        @await Html.PartialAsync("_UserNav")
        @await Html.PartialAsync("_ChangePassword", new App.Models.ManageViewModels.ChangePasswordViewModel())
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    @{await Html.RenderPartialAsync("_ToastrMsg");}
}
